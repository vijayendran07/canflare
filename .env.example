# Apps Script web app URL (ends with /exec) and the SECRET printed by setup()
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
# Admin panel
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# Set ONLY after the admin subdomain works, e.g. admin.example.com
ADMIN_HOST=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional – shown in the admin's "confirm + pay" WhatsApp message
NEXT_PUBLIC_UPI_ID=

# Optional – shopping concierge (off until set). Without it the floating button opens WhatsApp with the page pre-filled.
CONCIERGE_API_KEY=
CONCIERGE_MODEL=
# Optional – GA4 measurement ID (e.g. G-XXXXXXX). Analytics events are off until set.
NEXT_PUBLIC_ANALYTICS_ID=
